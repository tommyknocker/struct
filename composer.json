{
  "name": "tommyknocker/struct",
  "description": "Map external arrays and JSON into validated PHP DTOs and explicit outbound payloads",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "dto",
    "data-mapping",
    "validation",
    "serialization",
    "json",
    "typed-properties",
    "attributes",
    "api",
    "php"
  ],
  "authors": [
    {
      "name": "Vasiliy Krivoplyas",
      "email": "vasiliy@krivoplyas.com"
    }
  ],
  "require": {
    "php": "^8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0|^11.0",
    "phpstan/phpstan": "^2.0",
    "friendsofphp/php-cs-fixer": "^3.89"
  },
  "autoload": {
    "psr-4": {
      "tommyknocker\\struct\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "tommyknocker\\struct\\tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "./vendor/bin/phpunit",
    "test-examples": "./scripts/test-examples.sh",
    "test-coverage": "./vendor/bin/phpunit --coverage-html coverage",
    "phpstan": "./vendor/bin/phpstan analyse",
    "cs-fix": "./vendor/bin/php-cs-fixer fix",
    "cs-check": "./vendor/bin/php-cs-fixer fix --dry-run --diff",
    "cs-config": "./vendor/bin/php-cs-fixer config:dump",
    "struct-helper": "php scripts/struct-helper.php",
    "struct-helper-dry": "php scripts/struct-helper.php --dry-run",
    "struct-helper-verbose": "php scripts/struct-helper.php --verbose",
    "quality": [
      "@cs-check",
      "@phpstan",
      "@test"
    ],
    "quality-fix": [
      "@cs-fix",
      "@test"
    ],
    "check": [
      "@cs-check",
      "@phpstan",
      "@test",
      "@test-examples",
      "@test-package"
    ],
    "ci": [
      "@cs-check",
      "@phpstan",
      "@test",
      "@test-examples",
      "@test-package"
    ],
    "test-package": "bash scripts/test-package.sh"
  },
  "bin": [
    "scripts/struct-helper.php"
  ],
  "extra": {
    "phpstan": {
      "includes": [
        "extension.neon"
      ]
    }
  },
  "archive": {
    "exclude": [
      "/.git*",
      "/.agents/**",
      "/.aws/**",
      "/.codex/**",
      "/.idea/**",
      "/.codegraph/**",
      "/.vscode/**",
      "/.php*",
      "/.php*/**",
      "/phpstan.neon",
      "/phpunit.xml",
      "/composer.lock",
      "/vendor/**",
      "/tests/**",
      "/coverage/**",
      "/*.bak",
      "/scripts/test-examples.sh",
      "/.agents",
      "/.aws",
      "/.codex",
      "/.idea",
      "/.codegraph",
      "/.vscode",
      "/.phpunit.coverage",
      "/vendor",
      "/tests",
      "/coverage",
      "/scripts/test-package.sh"
    ]
  }
}
